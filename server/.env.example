PORT=5000
JWT_SECRET=your_secret_key_here
JWT_EXPIRES_IN=7d

# Hugging Face AI (free tier - get key at https://huggingface.co/settings/tokens)
# Optional: Without this key, the app uses a built-in enhanced image processor
# With this key, you get real AI-generated room redesigns
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HF_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# Poly.pizza 3D Models (free key - get at https://poly.pizza → Settings → API)
# Required to fetch 3D furniture models in the Studio 
POLY_PIZZA_API_KEY=your_poly_pizza_api_key_here
